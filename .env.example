# Copy to .env and fill in. All optional.
PORT=3000
SITE_URL=http://localhost:3000

# Where contact-form enquiries are emailed. If SMTP_HOST is empty,
# enquiries are only saved to data/enquiries.jsonl.
CONTACT_TO=hello@forgeworks.studio
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Forgeworks Studio <no-reply@forgeworks.studio>"
